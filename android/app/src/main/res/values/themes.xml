<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основная тема приложения -->
    <style name="Theme.Transport" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#070B14</item>
        <item name="android:navigationBarColor">#070B14</item>
        <item name="android:windowBackground">#070B14</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Экран запуска: тёмный фон и логотип в том же стиле -->
    <style name="Theme.Transport.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">350</item>
        <item name="postSplashScreenTheme">@style/Theme.Transport</item>
    </style>
</resources>
